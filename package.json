{
  "name": "wiredmind",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "dev": "pnpm --filter @wiredmind/web dev",
    "build": "pnpm --filter @wiredmind/web build",
    "lint": "eslint . && prettier --check . && pnpm data:lint && pnpm i18n:check",
    "typecheck": "tsc -p apps/web --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts && uv run --directory tools/data pytest",
    "data:fetch": "tsx scripts/fetch-data.ts",
    "data:cascade": "tsx scripts/bake-cascade.ts",
    "data:lint": "uv run --directory tools/data ruff check .",
    "format": "prettier --write .",
    "prepare": "node scripts/install-git-hooks.mjs",
    "i18n:check": "tsx scripts/i18n-check.ts",
    "i18n:draft": "tsx scripts/i18n-draft.ts",
    "og:fonts": "tsx scripts/og-fonts.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/eslintrc": "^3.3.1",
    "@formatjs/icu-messageformat-parser": "^3.5.20",
    "@gltf-transform/cli": "^4.2.1",
    "@types/node": "^22.18.6",
    "draco3dgltf": "1.5.7",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "prettier": "^3.6.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  },
  "funding": {
    "type": "buymeacoffee",
    "url": "https://buymeacoffee.com/guydahn"
  }
}
